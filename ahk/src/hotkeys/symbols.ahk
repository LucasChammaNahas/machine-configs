#Requires AutoHotkey v2.0

#HotIf !GetKeyState("CapsLock", "P")
    ;==> MAJOR KEYS <====================================================

    ;--> DEFAULT <-------------------------
    !Enter::     Send("{Enter}")
    !Backspace:: Send("{Backspace}")

    ;--> SPACE <---------------------------
    <!Space::  Send("{Space}")                      ;Alt L
    >!Space::  Send("{Space}")                      ;Alt R
    <^>!Space::Send("{Space}")                      ;AltGr

    ;==> LEFT HAND <=====================================================

    ;-->> Q <------------------------------
    <!q:: Send("{Raw}#")
    >!q:: Send("{Raw}0")
    <^>!q:: Send("{Raw}0")

    ;--> W <-------------------------------
    <!w:: Send("{Raw}|")
    >!w:: Send("{Raw}7")
    <^>!w:: Send("{Raw}7")

    ;--> E <-------------------------------
    <!e:: Send("{Raw}[")
    >!e:: Send("{Raw}8")
    <^>!e:: Send("{Raw}8")

    ;--> R <-------------------------------
    <!r:: Send("{Raw}]")
    >!r:: Send("{Raw}9")
    <^>!r:: Send("{Raw}9")

    ;--> T <-------------------------------
    <!t:: Send("{U+00A3}")   ;Alt L (£)
    >!t:: return             ;Alt R
    <^>!t:: return           ;AltGr

    ;--> A <-------------------------------
    <!a:: Send("{Raw}@")
    >!a:: Send("{Raw}0")
    <^>!a:: Send("{Raw}0")

    ;--> S <-------------------------------
    <!s:: Send("{Raw}(")
    >!s:: Send("{Raw}4")
    <^>!s:: Send("{Raw}4")

    ;--> D <-------------------------------
    <!d:: Send("{Raw})")
    >!d:: Send("{Raw}5")
    <^>!d:: Send("{Raw}5")

    ;--> F <-------------------------------
    <!f:: Send("{Raw}`%")       ;Alt L
    >!f:: Send("{Raw}6")        ;Alt R
    <^>!f:: Send("{Raw}6")      ;AltGr

    ;--> G <-------------------------------
    <!g:: Send("{Raw}*")
    >!g:: return
    <^>!g:: return

    ;--> Z <-------------------------------
    <!z:: return
    >!z:: Send("{Raw}0")
    <^>!z:: Send("{Raw}0")
    
    ;--> X <-------------------------------
    <!x:: Send("{Raw}\")
    >!x:: Send("{Raw}1")
    <^>!x:: Send("{Raw}1")

    ;--> C <-------------------------------
    <!c:: Send("{Raw}^")
    >!c:: Send("{Raw}2")
    <^>!c:: Send("{Raw}2")

    ;--> V <-------------------------------
    <!v:: Send("{Raw}$")
    >!v:: Send("{Raw}3")
    <^>!v:: Send("{Raw}3")

    ;--> B <-------------------------------
    <!b:: Send("{Raw}+")
    >!b:: return
    <^>!b:: return

    ;==> RIGHT HAND <====================================================

    ;--> Y <-------------------------------
    <!y:: Send("{Raw}~")
    >!y:: return
    <^>!y:: return

    ;--> U <-------------------------------
    <!u:: Send("{Raw}<")
    >!u:: Send("{Raw}<")
    <^>!u:: Send("{Raw}<")

    ;--> I <-------------------------------
    <!i:: Send("{Raw}=")
    >!i:: Send("{Raw}=")
    <^>!i:: Send("{Raw}=")

    ;--> O <-------------------------------
    <!o:: Send("{Raw}>")
    >!o:: Send("{Raw}>")
    <^>!o:: Send("{Raw}>")

    ;--> P <-------------------------------
    <!p:: Send("{Raw}!")
    >!p:: return
    <^>!p:: return

    ;--> H <-------------------------------
    <!h:: Send("{Raw}&")
    >!h:: Send("{Raw}`%")
    <^>!h:: Send("{Raw}`%")

    ;--> J <-------------------------------
    <!j:: Send("{Raw}{")
    >!j:: Send("{Raw}-")
    <^>!j:: Send("{Raw}-")

    ;--> K <-------------------------------
    <!k:: Send("{Raw}}")
    >!k:: Send("{Raw}+")
    <^>!k:: Send("{Raw}+")

    ;--> L <-------------------------------
    <!l:: Send("{Raw}``")
    >!l:: Send("{Raw}*")
    <^>!l:: Send("{Raw}*")

    ;--> ; <-------------------------------
    <!`;:: Send("{Raw}:")
    >!`;:: Send("{Raw}/")
    <^>!`;:: Send("{Raw}/")

    ;--> ' <-------------------------------
    <!':: Send('"')        ;Alt L

    ;--> N <-------------------------------
    <!n:: Send("{Raw}-")
    >!n:: return
    <^>!n:: return

    ;--> M <-------------------------------
    <!m:: Send("{Raw}_")
    >!m:: Send("{Raw}0")
    <^>!m:: Send("{Raw}0")

    ;--> , <-------------------------------
    <!,:: Send("{Raw},")
    >!,:: Send("{Raw},")
    <^>!,:: Send("{Raw},")

    ;--> . <-------------------------------
    <!.:: Send("{Raw}.")
    >!.:: Send("{Raw}.")
    <^>!.:: Send("{Raw}.")

    ;--> / <-------------------------------
    <!/:: Send("{Raw}?")
    >!/:: return
    <^>!/:: return

#HotIf
